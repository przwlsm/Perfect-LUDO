# Publishing identity (not needed for local play). Use your own registered IDs.
APP_DISPLAY_NAME=Ludo Club
EXPO_OWNER=
EAS_PROJECT_ID=
APP_ANDROID_PACKAGE=
APP_IOS_BUNDLE_IDENTIFIER=

# Future backend only; Firebase is not connected in the offline release.
# Firebase client config (public by design — safety comes from Firestore
# Security Rules + App Check, not from hiding these values).
# Copy this file to .env and fill in values from the Firebase console.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# reCAPTCHA v3 site key for Firebase App Check on web
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=
