# Publishing identity (not needed for local play). Use your own registered IDs.
APP_DISPLAY_NAME=Ludo Club
EXPO_OWNER=
EAS_PROJECT_ID=
APP_ANDROID_PACKAGE=
APP_IOS_BUNDLE_IDENTIFIER=

# Optional cloud sync. Leave blank to keep the app fully offline/local.
#
# Both values below are public by design — they ship inside the app bundle.
# Access is protected by Row Level Security policies on the database (see
# supabase/migrations), NOT by keeping these secret.
#
# Copy this file to .env and fill in from Supabase: Project Settings -> API.
# Use the "anon"/publishable key. NEVER put the service_role key or the
# postgres:// connection string in here — those bypass RLS entirely and
# would grant full database access to anyone who unpacks the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
