{
  "react-native-google-mobile-ads": {
    "android_sdk": "classic"
  },
  "expo": {
    "name": "Monsoon Fields",
    "slug": "monsoon",
    "version": "0.1.0",
    "scheme": "monsoon",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devmindslabs.monsoon",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.devmindslabs.monsoon",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0c1a1d",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0c1a1d"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "This lets us show ads that are more relevant to you."
        }
      ],
      "expo-iap",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#0c1a1d",
    "web": {
      "favicon": "./assets/images/favicon.png",
      "output": "single"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000,
      "url": "https://u.expo.dev/3e23ae03-9697-4d02-bbde-c3cced55281f"
    },
    "owner": "prwlsm-org",
    "extra": {
      "eas": {
        "projectId": "3e23ae03-9697-4d02-bbde-c3cced55281f"
      }
    }
  }
}
