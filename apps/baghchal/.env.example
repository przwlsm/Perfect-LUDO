# Online play. Leave both blank to keep the app fully offline.
#
# Both values are public by design: they ship inside the app bundle. Access
# is protected by Row Level Security and server functions (see
# supabase/migrations), not by keeping these secret.
#
# Copy this file to .env and fill in from Supabase: Project Settings -> API.
# Use the project URL (no path) and the "anon"/publishable key. NEVER put the
# service_role key or the postgres:// connection string here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Rewarded ads (AdMob). Development builds use Google's test ad unit and the
# test app IDs in app.json. For store builds set these as EAS secrets: the
# rewarded ad unit id (public, bundled) and the app ids (read by app.config.ts).
# A production build without the app ids refuses to build; a release without
# the ad unit id simply hides every "watch an ad" button.
EXPO_PUBLIC_ADMOB_REWARDED_ID=
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
